{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecruelsong.com/schemas/claim.schema.json",
  "title": "Karmein Chan Knowledge File — reserved atomic claims module",
  "description": "Defines the intended wrapper and minimum record contract for a future data/claims.json module. Version 0.3.0 contains no operative claim records and assigns no canonical claim-ID namespace.",
  "type": "object",
  "required": [
    "file",
    "schema_version",
    "updated",
    "claim_model",
    "metadata",
    "claims"
  ],
  "properties": {
    "file": {
      "const": "claims.json"
    },
    "schema_version": {
      "$ref": "#/$defs/semver"
    },
    "updated": {
      "$ref": "#/$defs/isoDate"
    },
    "claim_model": {
      "$ref": "#/$defs/claim"
    },
    "metadata": {
      "type": "object",
      "required": [
        "description",
        "record_count",
        "status"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "reserved",
            "experimental",
            "active"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimRecord"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^(?:KCSRC\\d{5}|TCS-WWKC-WEB-\\d{4}|\\.\\.\\.)$"
    },
    "personId": {
      "type": "string",
      "pattern": "^TCS-WWKC-PPL-\\d{4}$"
    },
    "placeId": {
      "type": "string",
      "pattern": "^KCPLACE\\d{4}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^KCEVT\\d{4}$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^KCQST\\d{4}$"
    },
    "reviewFlags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "claim": {
      "type": "object",
      "description": "Atomic value with semantic type, precision, inference score and supporting source references.",
      "required": [
        "value",
        "units",
        "precision",
        "inference_score",
        "source_ids"
      ],
      "properties": {
        "value": {},
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inference_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "embeddedSource": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "url",
        "locators"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceRef"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "entityReference": {
      "type": "object",
      "required": [
        "entity_type",
        "entity_id",
        "field_path"
      ],
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "source",
            "person",
            "place",
            "timeline_event",
            "open_question",
            "photo"
          ]
        },
        "entity_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "field_path": {
          "type": "string",
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$"
        }
      },
      "additionalProperties": false
    },
    "claimRecord": {
      "type": "object",
      "required": [
        "id",
        "record_type",
        "subject",
        "predicate",
        "object",
        "precision",
        "inference_score",
        "source_ids",
        "review_flags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{3,63}$"
        },
        "record_type": {
          "const": "claim"
        },
        "subject": {
          "$ref": "#/$defs/entityReference"
        },
        "predicate": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "object": {},
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inference_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        },
        "source_locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "disputed",
            "superseded",
            "withdrawn",
            "internal_only"
          ]
        },
        "review_flags": {
          "$ref": "#/$defs/reviewFlags"
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "The zero-byte data/claims.json placeholder cannot be JSON-schema validated until it is converted into a JSON object matching this wrapper."
}
