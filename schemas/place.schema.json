{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecruelsong.com/schemas/place.schema.json",
  "title": "Karmein Chan Knowledge File — places module",
  "description": "Validates the complete data/places.json wrapper and place records.",
  "type": "object",
  "required": [
    "file",
    "schema_version",
    "updated",
    "claim_model",
    "places"
  ],
  "properties": {
    "file": {
      "const": "places.json"
    },
    "schema_version": {
      "$ref": "#/$defs/semver"
    },
    "updated": {
      "$ref": "#/$defs/isoDate"
    },
    "claim_model": {
      "$ref": "#/$defs/claim"
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/placeRecord"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^(?:KCSRC\\d{5}|TCS-WWKC-WEB-\\d{4}|\\.\\.\\.)$"
    },
    "personId": {
      "type": "string",
      "pattern": "^TCS-WWKC-PPL-\\d{4}$"
    },
    "placeId": {
      "type": "string",
      "pattern": "^KCPLACE\\d{4}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^KCEVT\\d{4}$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^KCQST\\d{4}$"
    },
    "reviewFlags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "claim": {
      "type": "object",
      "description": "Atomic value with semantic type, precision, inference score and supporting source references.",
      "required": [
        "value",
        "units",
        "precision",
        "inference_score",
        "source_ids"
      ],
      "properties": {
        "value": {},
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inference_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "embeddedSource": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "url",
        "locators"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceRef"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "coordinatesClaim": {
      "type": "object",
      "required": [
        "value",
        "units",
        "precision",
        "inference_score",
        "source_ids"
      ],
      "properties": {
        "value": {
          "type": "object",
          "required": [
            "latitude",
            "longitude"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "additionalProperties": false
        },
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inference_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "street_address": {
          "$ref": "#/$defs/claim"
        },
        "street_context": {
          "$ref": "#/$defs/claim"
        },
        "suburb": {
          "$ref": "#/$defs/claim"
        },
        "city": {
          "$ref": "#/$defs/claim"
        },
        "state": {
          "$ref": "#/$defs/claim"
        },
        "country": {
          "$ref": "#/$defs/claim"
        },
        "nearby_locality": {
          "$ref": "#/$defs/claim"
        },
        "coordinates": {
          "$ref": "#/$defs/coordinatesClaim"
        }
      },
      "additionalProperties": false
    },
    "placeRecord": {
      "type": "object",
      "required": [
        "id",
        "canonical_name",
        "place_type",
        "location",
        "case_roles",
        "review_flags"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/placeId"
        },
        "canonical_name": {
          "$ref": "#/$defs/claim"
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "place_type": {
          "$ref": "#/$defs/claim"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "historical_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "case_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "privacy_level": {
          "$ref": "#/$defs/claim"
        },
        "review_flags": {
          "$ref": "#/$defs/reviewFlags"
        }
      },
      "additionalProperties": false
    }
  }
}
