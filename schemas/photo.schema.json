{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecruelsong.com/schemas/photo.schema.json",
  "title": "Karmein Chan Knowledge File — reserved photographs module",
  "description": "Defines the intended wrapper and minimum record contract for a future data/photos.json module. Version 0.3.0 contains no operative photo records and assigns no canonical photo-ID namespace.",
  "type": "object",
  "required": [
    "file",
    "schema_version",
    "updated",
    "claim_model",
    "metadata",
    "photos"
  ],
  "properties": {
    "file": {
      "const": "photos.json"
    },
    "schema_version": {
      "$ref": "#/$defs/semver"
    },
    "updated": {
      "$ref": "#/$defs/isoDate"
    },
    "claim_model": {
      "$ref": "#/$defs/claim"
    },
    "metadata": {
      "type": "object",
      "required": [
        "description",
        "record_count",
        "status"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "reserved",
            "experimental",
            "active"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "photos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/photoRecord"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^(?:KCSRC\\d{5}|TCS-WWKC-WEB-\\d{4}|\\.\\.\\.)$"
    },
    "personId": {
      "type": "string",
      "pattern": "^TCS-WWKC-PPL-\\d{4}$"
    },
    "placeId": {
      "type": "string",
      "pattern": "^KCPLACE\\d{4}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^KCEVT\\d{4}$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^KCQST\\d{4}$"
    },
    "reviewFlags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "claim": {
      "type": "object",
      "description": "Atomic value with semantic type, precision, inference score and supporting source references.",
      "required": [
        "value",
        "units",
        "precision",
        "inference_score",
        "source_ids"
      ],
      "properties": {
        "value": {},
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inference_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "embeddedSource": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "url",
        "locators"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceRef"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "transformation": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "crop",
            "rotation",
            "straightening",
            "colourization",
            "cleanup",
            "restoration",
            "upscale",
            "composite",
            "ai_assisted_edit",
            "other"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "date": {
          "$ref": "#/$defs/isoDate"
        },
        "tool": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "photoRecord": {
      "type": "object",
      "required": [
        "id",
        "record_type",
        "title",
        "depicted_person_ids",
        "depicted_place_ids",
        "source_ids",
        "provenance",
        "copyright_status",
        "publication_status",
        "transformations",
        "review_flags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{3,63}$"
        },
        "record_type": {
          "const": "photo"
        },
        "title": {
          "$ref": "#/$defs/claim"
        },
        "description": {
          "$ref": "#/$defs/claim"
        },
        "depicted_person_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/personId"
          },
          "uniqueItems": true
        },
        "depicted_place_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placeId"
          },
          "uniqueItems": true
        },
        "creator": {
          "$ref": "#/$defs/claim"
        },
        "date": {
          "$ref": "#/$defs/claim"
        },
        "location": {
          "$ref": "#/$defs/claim"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/claim"
        },
        "copyright_status": {
          "$ref": "#/$defs/claim"
        },
        "reuse_status": {
          "$ref": "#/$defs/claim"
        },
        "publication_status": {
          "$ref": "#/$defs/claim"
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformation"
          }
        },
        "privacy_level": {
          "$ref": "#/$defs/claim"
        },
        "dignity_restrictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "review_flags": {
          "$ref": "#/$defs/reviewFlags"
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "The zero-byte data/photos.json placeholder cannot be JSON-schema validated until it is converted into a JSON object matching this wrapper."
}
