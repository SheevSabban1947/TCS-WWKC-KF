{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecruelsong.com/schemas/person.schema.json",
  "title": "Karmein Chan Knowledge File — people module",
  "description": "Validates the complete data/people.json wrapper, core people and contextual people.",
  "type": "object",
  "required": [
    "file",
    "schema_version",
    "updated",
    "claim_model",
    "metadata",
    "layers",
    "controlled_vocabularies",
    "pending_global_work",
    "people",
    "contextual_people"
  ],
  "properties": {
    "file": {
      "const": "people.json"
    },
    "schema_version": {
      "$ref": "#/$defs/semver"
    },
    "updated": {
      "$ref": "#/$defs/isoDate"
    },
    "claim_model": {
      "$ref": "#/$defs/claim"
    },
    "metadata": {
      "type": "object",
      "required": [
        "description",
        "total_person_count",
        "core_person_count",
        "contextual_person_count",
        "previous_version",
        "change_summary",
        "factual_certification_status",
        "identity_handling_note"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "total_person_count": {
          "type": "integer",
          "minimum": 0
        },
        "core_person_count": {
          "type": "integer",
          "minimum": 0
        },
        "contextual_person_count": {
          "type": "integer",
          "minimum": 0
        },
        "previous_version": {
          "$ref": "#/$defs/semver"
        },
        "change_summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "factual_certification_status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "identity_handling_note": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "object",
      "required": [
        "people",
        "contextual_people"
      ],
      "properties": {
        "people": {
          "$ref": "#/$defs/layerDefinition"
        },
        "contextual_people": {
          "$ref": "#/$defs/layerDefinition"
        }
      },
      "additionalProperties": false
    },
    "controlled_vocabularies": {
      "type": "object",
      "required": [
        "role_units",
        "record_scope",
        "verification_status",
        "publication_status",
        "identity_relationship_status",
        "inference_score"
      ],
      "properties": {
        "role_units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "record_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "verification_status": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "publication_status": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "identity_relationship_status": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "inference_score": {
          "type": "object",
          "required": [
            "0",
            "1",
            "2",
            "3"
          ],
          "properties": {
            "0": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "1": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "2": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "3": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pending_global_work": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pendingWork"
      }
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/personRecord"
      }
    },
    "contextual_people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/personRecord"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^(?:KCSRC\\d{5}|TCS-WWKC-WEB-\\d{4}|\\.\\.\\.)$"
    },
    "personId": {
      "type": "string",
      "pattern": "^TCS-WWKC-PPL-\\d{4}$"
    },
    "placeId": {
      "type": "string",
      "pattern": "^KCPLACE\\d{4}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^KCEVT\\d{4}$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^KCQST\\d{4}$"
    },
    "reviewFlags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "claim": {
      "type": "object",
      "description": "Atomic value with semantic type, precision, inference score and supporting source references.",
      "required": [
        "value",
        "units",
        "precision",
        "inference_score",
        "source_ids"
      ],
      "properties": {
        "value": {},
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inference_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "embeddedSource": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "url",
        "locators"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceRef"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "relationship",
        "person_id"
      ],
      "properties": {
        "relationship": {
          "$ref": "#/$defs/claim"
        },
        "person_id": {
          "$ref": "#/$defs/claim"
        }
      },
      "additionalProperties": false
    },
    "residence": {
      "type": "object",
      "required": [
        "place",
        "period"
      ],
      "properties": {
        "place": {
          "$ref": "#/$defs/claim"
        },
        "period": {
          "$ref": "#/$defs/claim"
        }
      },
      "additionalProperties": false
    },
    "education": {
      "type": "object",
      "required": [
        "institution"
      ],
      "properties": {
        "institution": {
          "$ref": "#/$defs/claim"
        },
        "year_level_1991": {
          "$ref": "#/$defs/claim"
        }
      },
      "additionalProperties": false
    },
    "lifeEvent": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/claim"
      }
    },
    "identityHypothesis": {
      "type": "object",
      "required": [
        "person_id",
        "status",
        "rationale"
      ],
      "properties": {
        "person_id": {
          "$ref": "#/$defs/claim"
        },
        "status": {
          "$ref": "#/$defs/claim"
        },
        "rationale": {
          "$ref": "#/$defs/claim"
        }
      },
      "additionalProperties": false
    },
    "contextSource": {
      "type": "object",
      "required": [
        "source_id",
        "scope",
        "note"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/claim"
        },
        "scope": {
          "$ref": "#/$defs/claim"
        },
        "note": {
          "$ref": "#/$defs/claim"
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "claim_locator_status",
        "publication_status",
        "review_note"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/claim"
        },
        "claim_locator_status": {
          "$ref": "#/$defs/claim"
        },
        "publication_status": {
          "$ref": "#/$defs/claim"
        },
        "review_note": {
          "$ref": "#/$defs/claim"
        }
      },
      "additionalProperties": false
    },
    "personRecord": {
      "type": "object",
      "required": [
        "id",
        "record_type",
        "display_name",
        "names",
        "roles",
        "public_status",
        "review_flags",
        "identity_status",
        "record_scope",
        "verification"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/personId"
        },
        "record_type": {
          "const": "person"
        },
        "display_name": {
          "$ref": "#/$defs/claim"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "birth": {
          "type": "object",
          "required": [
            "date"
          ],
          "properties": {
            "date": {
              "$ref": "#/$defs/claim"
            },
            "place": {
              "$ref": "#/$defs/claim"
            }
          },
          "additionalProperties": false
        },
        "death": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "date": {
              "$ref": "#/$defs/claim"
            },
            "year": {
              "$ref": "#/$defs/claim"
            },
            "place": {
              "$ref": "#/$defs/claim"
            }
          },
          "additionalProperties": false
        },
        "family_relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "residences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/residence"
          }
        },
        "education": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/education"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "events": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/lifeEvent"
          }
        },
        "possible_same_as": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identityHypothesis"
          }
        },
        "context_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextSource"
          }
        },
        "entity_resolution_status": {
          "$ref": "#/$defs/claim"
        },
        "public_status": {
          "$ref": "#/$defs/claim"
        },
        "review_flags": {
          "$ref": "#/$defs/reviewFlags"
        },
        "identity_status": {
          "$ref": "#/$defs/claim"
        },
        "record_scope": {
          "$ref": "#/$defs/claim"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "additionalProperties": false
    },
    "layerDefinition": {
      "type": "object",
      "required": [
        "scope",
        "description"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "pendingWork": {
      "type": "object",
      "required": [
        "code",
        "status",
        "description"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    }
  }
}
